</head>
<body>

    @Html.Action("navMenu", "Home")

    @Html.Action("lastNews", "Home")

    @Html.Action("_newsgroupFatures", "Home", new { count = 4 })
    <!-->
    <!-->
    <div class="post-area pd-top-75 pd-bottom-50" id="trending">
