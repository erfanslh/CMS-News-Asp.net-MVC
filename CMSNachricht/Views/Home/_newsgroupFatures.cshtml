@model IEnumerable<CMSNachricht.Models.ViewModel.NewsViewModel>

<div class="banner-area banner-inner-1 bg-black" id="banner">
    <div class="container">
        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-sm-6">
                    <div class="single-post-wrap style-white">
                        <div class="thumb">
                            <img src="~/Images/News/@item.ImageName" alt="@item.NewsTitle">
                            <a class="tag-base tag-blue" href="/Home/newsDetail/@item.NewsId">@item.newsGroup.NewsGroupTitle <span class="badge badge-light">@item.newsGroup.FkNews.Count</span>
                            <img style="width:18px;height:18px; margin-left:5px;" src="~/Images/NewsGroup/@item.newsGroup.NewsGroupImage" /></a>
                        </div>
                        <div class="details">
                            <h6 class="title">
                            <a href="/Home/newsDetail/@item.NewsId">
                                @item.NewsTitle</a></h6>
                            <div class="post-meta-single mt-3">
                                <ul>
                                    <li><i class="fa fa-clock-o"></i>@item.RegisterDate</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>


