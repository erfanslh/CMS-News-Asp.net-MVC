<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Styles.Render("~/Content/viewCss")
    <!-- Bootstrap CSS -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Your custom CSS -->
    <link href="~/Content/custom.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-danger">
            <div class="container">
                <a class="navbar-brand" href="~/Account/Index">Home</a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ml-auto">
                        <li class="nav-item">
                            <a class="nav-link" style="color:white" href="~/Admin/News/Index">News</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" style="color:white" href="~/Admin/NewsGroup/Index">NewsGroup</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" style="color:white" href="~/Admin/Comments/Index">Comments</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" style="color:white" href="~/Admin/Authors/Index">Authors</a>
                        </li>
                        <li class="nav-item">
                            <i class="bi bi-box-arrow-right"></i>
                            <a class="nav-link" style="color:gray" href="~/Account/LogOut">Logout</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    @Scripts.Render("~/bundles/jquery")
    @*@Scripts.Render("~/bundles/bootstrap")*@
    @RenderSection("scripts", required: false)

    <!-- CKEditor Script -->
    <script src="https://cdn.ckeditor.com/ckeditor5/41.2.1/classic/ckeditor.js"></script>
    <script>
        ClassicEditor
            .create(document.querySelector('#NewsDescription'))
            .catch(error => {
                console.error(error);
            });
    </script>
</body>
</html>
