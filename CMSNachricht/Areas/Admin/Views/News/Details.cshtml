

@model CMSNachricht.Models.ViewModel.NewsViewModel

@{
    ViewBag.Title = "Details";
}



<div class="details-container">
    <h2>Detail der Nachricht</h2>
    <div>
        <h4>@Html.DisplayFor(model => model.NewsTitle)</h4>
        <hr />
        <dl class="dl-horizontal">
            <dt>Group</dt>
            <dd>@Html.DisplayFor(model => model.newsGroup.NewsGroupTitle)</dd>

            <dt>@Html.DisplayNameFor(model => model.NewsDescription)</dt>
            <dd>@Html.Raw(Model.NewsDescription)</dd>

            <dt>@Html.DisplayNameFor(model => model.ImageName)</dt>
            <dd><img src="~/Images/News/@Model.ImageName" alt="News Image" /></dd>

            <dt>@Html.DisplayNameFor(model => model.RegisterDate)</dt>
            <dd>@Html.DisplayFor(model => model.RegisterDate)</dd>

            <dt>@Html.DisplayNameFor(model => model.IsActive)</dt>
            <dd>
                @if (Model.IsActive == true)
                {
                    <span class="status-badge published">Veröffentlicht</span>
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#5cb85c" class="bi bi-check" viewBox="0 0 16 16">
                            <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z" />
                        </svg>
                    </span>
                }
                else
                {
                    <span class="status-badge paused">Pausiert</span>
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="red" class="bi bi-x" viewBox="0 0 16 16">
                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708" />
                        </svg>
                    </span>
                }
            </dd>

            <dt>@Html.DisplayNameFor(model => model.See)</dt>
            <dd>@Html.DisplayFor(model => model.See)</dd>

            <dt>@Html.DisplayNameFor(model => model.Like)</dt>
            <dd>@Html.DisplayFor(model => model.Like)</dd>
        </dl>
    </div>
    <div class="action-links">
        @Html.ActionLink("Edit", "Edit", new { id = Model.NewsId })
        @Html.ActionLink("Back to List", "Index")
    </div>
</div>
