@model CMSNachricht.Models.ViewModel.NewsGroupViewModel

@{
    ViewBag.Title = "Create";
}

<h2>NewsGroup hinzufügen</h2>


@using (Html.BeginForm("Create","NewsGroup",FormMethod.Post,new { enctype="multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @*@Html.HiddenFor(model=> model.NewsGroupId)*@   
       
    <div class="form-horizontal">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })


        <div class="form-group">
            @Html.LabelFor(model => model.NewsGroupTitle, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.NewsGroupTitle, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.NewsGroupTitle, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.NewsGroupImage, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <img class="img50px" id="impPrev" src="~/Images/NewsGroup/Null.png" />
                <input type="file" name="imgupload" id="imgupload" onchange="ShowPreview(this)" />
            </div>
        </div>


        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-success" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
