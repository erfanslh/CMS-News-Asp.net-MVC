@model IEnumerable<CMSNachricht.Models.ViewModel.NewsGroupViewModel>

@{
    ViewBag.Title = "Index";
}

<h2 class="alert-link">NewsGroup Items</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.NewsGroupTitle)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.NewsGroupImage)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.NewsGroupTitle)
        </td>
        <td>
            <img class="img50px" src="~/Images/NewsGroup/@item.NewsGroupImage"/>
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.NewsGroupId }) |
            @Html.ActionLink("Details", "Details", new { id=item.NewsGroupId }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.NewsGroupId })
        </td>
    </tr>
}

</table>
